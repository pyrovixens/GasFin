# ==========================================
# GASTFIN - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# DO NOT COMMIT REAL PRODUCTION KEYS TO PUBLIC REPOSITORIES
# Rename this file to .env.local for local development

# Supabase Public Anonymous API (RLS Protected)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional Custom Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Environment & Security
VITE_APP_ENV=production
VITE_ENABLE_SECURITY_LOGS=false
